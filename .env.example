# Copy to .env.local and fill in. The site runs without these (leads log to
# the server console), but production needs them to actually deliver leads.

# --- Email delivery (Resend) ---
# Get a key at https://resend.com. Verify the poweredgetx.com domain to send.
RESEND_API_KEY=
LEAD_TO_EMAIL=info@poweredgetx.com

# --- Jobber (lead -> Jobber request) ---
# Jobber uses a GraphQL API with an OAuth bearer token.
# See app/api/lead/route.ts for where to drop in the mutation.
JOBBER_API_TOKEN=

# --- Analytics & call tracking (optional; site runs clean without them) ---
# GA4 measurement ID (Analytics > Admin > Data Streams), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# CallRail DNI swap script src from your CallRail JS snippet, e.g.
# //cdn.callrail.com/companies/123456/abcdef/12/swap.js
NEXT_PUBLIC_CALLRAIL_SRC=

# --- Roof estimator: satellite measurement (Google Solar API) ---
# When set, /roof-estimate measures the actual roof area from aerial imagery
# (most accurate). Without it, falls back to free OSM footprints + manual entry.
# Get it: Google Cloud Console -> enable "Solar API" -> create API key -> enable billing.
GOOGLE_SOLAR_API_KEY=
