# Copy to .env.local and fill in. The site runs without these (leads log to
# the server console), but production needs them to actually deliver leads.

# --- Email delivery (Resend) ---
# Get a key at https://resend.com. Verify the poweredgetx.com domain to send.
RESEND_API_KEY=
LEAD_TO_EMAIL=info@poweredgetx.com

# --- Jobber (lead -> Jobber request) ---
# Jobber uses a GraphQL API with an OAuth bearer token.
# See app/api/lead/route.ts for where to drop in the mutation.
JOBBER_API_TOKEN=
